# Copy to .env and edit. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for TOTP secrets at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=
INGEST_API_KEY=change-me-ingest-key
# DATABASE_URL=sqlite:////absolute/path/threats.db
SENSITIVITY_THRESHOLD=0.70

# --- Email alerts (leave SMTP_HOST empty to write .eml files to instance/outbox/) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=threat-dashboard@example.com
ALERT_RECIPIENTS=secops@example.com
# Minimum severity that triggers email: Critical = immediate, High = hourly digest
ALERT_MIN_SEVERITY=High
ALERT_GROUPING_MINUTES=10
EMAIL_PER_ALERT_MINUTES=30
EMAIL_MAX_PER_HOUR=20
DIGEST_INTERVAL_MINUTES=60
PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- SMS alerts (FR-10) through Twilio ---
# With SMS_ENABLED=false or any Twilio value empty, SMS messages are written to instance/sms_outbox/*.txt (demo mode).
# Numbers and the on/off switch can also be changed on the Notifications page; the Twilio credentials live here only.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (E.164), e.g. +15017122661
TWILIO_FROM_NUMBER=
# Comma-separated E.164 mobile numbers; on a Twilio trial each one must be a verified caller ID
SMS_RECIPIENTS=
# Critical (recommended) or High
SMS_MIN_SEVERITY=Critical
SMS_MAX_PER_HOUR=10
SMS_PER_ALERT_MINUTES=60
# Set true when served over HTTPS
SESSION_COOKIE_SECURE=false

# --- Models ---
# isolation_forest (unsupervised) or random_forest (supervised); admins can switch on the Models page
ACTIVE_MODEL=isolation_forest
# EXPLAINER=saabas   # force the built-in path-contribution explainer even if shap is installed

# --- Streaming collectors (or run: python scripts/collector.py) ---
ENABLE_COLLECTORS=false
COLLECTOR_BIND=127.0.0.1
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
NETFLOW_UDP_PORT=2055
COLLECTOR_FLUSH_SECONDS=1

# --- Geo-map (python scripts/download_geoip.py) and IP privacy ---
# GEOIP_DB=data/geo/dbip-city-lite.mmdb
SITE_NAME=Head office
SITE_LAT=-37.8136
SITE_LON=144.9631
# full | truncate | hash  (also changeable on the Notifications & privacy page)
IP_DISPLAY_MODE=full
# hash | truncate - how IPs are shown to the LLM (never full)
LLM_IP_MODE=hash
# Key for IP pseudonyms (defaults to SECRET_KEY)
IP_HASH_KEY=

# --- AI incident reports (OpenAI-compatible chat completions API) ---
# Leave LLM_API_KEY empty for deterministic template reports.
# Local, free option: Ollama (https://ollama.com) -> LLM_API_BASE=http://127.0.0.1:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# UC-08 A1 interval .pcap capture folder: drop capture files into this folder; they are checked
# every PCAP_INTERVAL_SECONDS (also "Check capture folder now" on the Data sources page).
PCAP_WATCH_ENABLED=0
PCAP_WATCH_DIR=instance/pcap_inbox
PCAP_INTERVAL_SECONDS=300
# UC-02 A1 lab captures / saved uploads used as replay datasets
DATASET_DIR=instance/datasets
